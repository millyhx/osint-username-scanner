<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.milly.osint.ui.UsernameIntelligenceController"
      spacing="10" style="-fx-padding: 15;">

    <Label text="Username Intelligence"/>
    <TextField fx:id="usernameField" promptText="Enter a username"/>
    <Button text="Analyse" onAction="#onAnalyseClicked"/>

    <ListView fx:id="resultsList" prefHeight="300"/>
</VBox>
